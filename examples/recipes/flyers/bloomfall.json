{
  "$schema": "../../../schema/recipe.schema.json",
  "name": "bloomfall",
  "description": "Riso, pink + blue: two misregistered inks overprinting on cream paper. A sun and the name in pink; the cut-out portrait halftoned in blue with the meta. The flyer is the earlier port (examples/recipes/bloomfall.json) plus print grain; with format 'release' it re-composes for a 3000×3000 cover: the sun and portrait a little smaller, the name across the foot in pink, the release title under it in blue. Re-expressed from the Logomarks scenes lab (FlyerCards, 'Riso · pink + blue').",
  "params": {
    "name": "Bloomfall",
    "issue": "Nº 3",
    "kicker": "a riso + zine fair",
    "when": "Sat 7 + Sun 8 June",
    "hours": "10 — 5, free in",
    "venue": "The Old Tannery",
    "address": "Mill Lane, Wexley",
    "url": "bloomfall.fair",
    "pink": "#ff48b0",
    "blue": "#0078bf",
    "paper": "#f4efe4",
    "artist": "Bloomfall",
    "release": "Ink & Pollen"
  },
  "layers": [
    { "id": "paper", "type": "solid", "color": "{paper}" },
    { "id": "fibres", "type": "texture", "kind": "paper" },
    {
      "id": "poster",
      "type": "group",
      "when": { "not": { "format": "release" } },
      "viewBox": [0, 0, 400, 500],
      "fit": "contain",
      "layers": [
        {
          "id": "pink",
          "type": "group",
          "blend": "multiply",
          "transform": { "translate": [1.8, -1.3], "rotate": 0.25, "origin": [200, 250] },
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "sun", "type": "shape", "kind": "circle", "cx": 214, "cy": 176, "r": 134, "fill": "{pink}" },
            { "id": "title", "type": "text", "content": "{name}", "font": "Bricolage Grotesque", "weight": 800, "size": 104, "letterSpacing": -0.048, "x": 16, "y": 446, "width": 368, "color": "{pink}" },
            { "id": "mark", "type": "icon", "markup": "{mark}", "x": 330, "y": 22, "size": 50, "color": "{pink}", "when": "mark" }
          ]
        },
        {
          "id": "blue",
          "type": "group",
          "blend": "multiply",
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "portrait", "type": "image", "src": "{cutout}", "x": -118, "y": 30, "width": 636, "height": 356, "fit": "cover", "effects": [{ "kind": "halftone", "ink": "{blue}", "cell": 5.2, "angle": 15, "contrast": 1.2, "lift": -0.18 }], "when": "cutout" },
            { "id": "head", "type": "table", "font": "Bricolage Grotesque", "weight": 600, "size": 10, "color": "{blue}", "y": 30, "rowHeight": 12, "columns": [{ "x": 16 }], "rows": [[{ "content": "{issue}", "weight": 800 }], ["{kicker}"]] },
            {
              "id": "foot",
              "type": "table",
              "font": "Bricolage Grotesque",
              "weight": 600,
              "size": 10,
              "color": "{blue}",
              "y": 472,
              "rowHeight": 12,
              "columns": [{ "x": 16 }, { "x": 200 }, { "x": 384, "align": "right" }],
              "rows": [[{ "content": "{when}", "weight": 800 }, { "content": "{venue}", "weight": 800 }, ""], ["{hours}", "{address}", "{url}"]]
            }
          ]
        }
      ]
    },
    {
      "id": "cover",
      "type": "group",
      "when": { "format": "release" },
      "viewBox": [0, 0, 400, 400],
      "fit": "contain",
      "layers": [
        {
          "id": "pink",
          "type": "group",
          "blend": "multiply",
          "transform": { "translate": [1.8, -1.3], "rotate": 0.25, "origin": [200, 200] },
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "sun", "type": "shape", "kind": "circle", "cx": 214, "cy": 140, "r": 112, "fill": "{pink}" },
            { "id": "artist", "type": "text", "content": "{artist}", "font": "Bricolage Grotesque", "weight": 800, "size": 104, "letterSpacing": -0.048, "x": 16, "y": 334, "width": 368, "color": "{pink}" },
            { "id": "mark", "type": "icon", "markup": "{mark}", "x": 334, "y": 16, "size": 50, "color": "{pink}", "when": "mark" }
          ]
        },
        {
          "id": "blue",
          "type": "group",
          "blend": "multiply",
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "portrait", "type": "image", "src": "{cutout}", "x": -54.5, "y": 8, "width": 509, "height": 285, "fit": "cover", "effects": [{ "kind": "halftone", "ink": "{blue}", "cell": 4.6, "angle": 15, "contrast": 1.2, "lift": -0.18 }], "when": "cutout" },
            { "id": "title", "type": "text", "content": "{release}", "font": "Bricolage Grotesque", "weight": 800, "size": 40, "letterSpacing": -0.03, "x": 17, "y": 382, "color": "{blue}" }
          ]
        }
      ]
    },
    { "id": "print", "type": "grain", "amount": 0.04, "size": 1.5, "blend": "multiply" }
  ]
}
