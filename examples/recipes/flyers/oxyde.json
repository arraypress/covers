    "acid": "#c6ff1a",
    "name": "OXYDE",
    "top": [[{ "content": "OXYDE/004", "weight": 700 }, "[ SAT 29.11.26 ]", "23:00—07:00"]],
    "left": [[{ "content": "SND—SYS", "opacity": 0.6 }], ["FUNKTION 2"]],
