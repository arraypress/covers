          "type": "shape",
          "kind": "rect",
          "x": 0,
          "y": 0,
          "width": 250,
          "height": 250,
          "fill": "@accent",
          "when": {
            "odd": 0
          }
        },
        {
          "id": "m0",
          "type": "icon",
          "markup": "{mark}",
          "x": 50,
          "y": 50,
          "size": 150,
          "color": {
            "if": {
              "odd": 0
            },
            "then": "@onAccent",
            "else": "@text"
          },
          "transform": {
            "if": {
              "odd": 0
            },
            "then": {
