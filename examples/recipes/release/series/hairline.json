{
  "$schema": "../../../../schema/recipe.schema.json",
  "name": "hairline",
  "description": "Series (v2): airy minimal on near-white. The palette's gradient lives in a tall opal pill on the right (or, with a {photo}, the photo inside it), echoed by a hairline pill round it; four corner ticks stand in for a frame; the series wordmark sits off-centre in a narrow left column above a short rule, the artist and the title (with its {version} in the second colour) under it; the issue number is a huge hairline-weight numeral, faint in the accent, behind everything at the bottom-left. Slots: {label}, {artist}, {title}, {version}, {catalog}, {photo} (optional), the palette (bg = page, colors = the gradient stops, accent = type and ticks). Fonts: Outfit, Geist.",
  "params": {
    "artist": "Artist",
    "version": "",
    "catalog": "",
    "small": 26
  },
  "vars": {
    "a": {
      "range": [
        100,
        160
      ]
    }
  },
  "layers": [
    {
      "id": "page",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "breathA",
          "type": "shape",
          "kind": "circle",
          "cx": 80,
          "cy": 920,
          "r": 260,
          "fill": "@colors.0",
          "opacity": 0.13,
          "soft": 120
        },
        {
          "id": "breathB",
          "type": "shape",
          "kind": "circle",
          "cx": 930,
          "cy": 90,
          "r": 240,
          "fill": "@colors.2",
          "opacity": 0.12,
          "soft": 120
        },
        {
          "id": "numeral",
          "type": "text",
          "when": "catalog",
          "content": "{catalog}",
          "font": "Outfit",
          "weight": 100,
          "size": 620,
          "letterSpacing": -0.04,
          "x": 40,
          "y": 940,
          "color": "@accent",
          "opacity": 0.13
        },
        {
          "id": "opal",
          "type": "shape",
          "when": {
            "not": "photo"
          },
          "kind": "rect",
          "x": 600,
          "y": 96,
          "width": 300,
          "height": 808,
          "radius": 150,
          "fill": {
            "type": "linear",
            "colors": [
              "@colors.0",
              "@colors.1",
              "@colors.2",
              {
                "mix": [
                  "@colors.2",
                  "@accent",
                  0.45
                ]
              }
            ],
            "angle": "$a"
          }
        },
        {
          "id": "opalPhoto",
          "type": "image",
          "when": "photo",
          "src": "{photo}",
          "x": 600,
          "y": 96,
          "width": 300,
          "height": 808,
          "fit": "cover",
          "effects": [
            {
              "kind": "saturate",
              "amount": 1.1
            }
          ],
          "clip": [
            {
              "id": "opalClip",
              "type": "shape",
              "kind": "rect",
              "x": 600,
              "y": 96,
              "width": 300,
              "height": 808,
              "radius": 150,
              "fill": "#000000"
            }
          ]
        },
        {
          "id": "opalLine",
          "type": "shape",
          "kind": "rect",
          "x": 584,
          "y": 80,
          "width": 332,
          "height": 840,
          "radius": 166,
          "fill": "none",
          "strokeWidth": 1.2,
          "stroke": {
            "type": "linear",
            "colors": [
              "@colors.0",
              "@colors.2"
            ],
            "angle": "$a"
          }
        },
        {
          "id": "corners",
          "type": "shape",
          "items": [
            {
              "kind": "line",
              "x1": 40,
              "y1": 40,
              "x2": 70,
              "y2": 40
            },
            {
              "kind": "line",
              "x1": 40,
              "y1": 40,
              "x2": 40,
              "y2": 70
            },
            {
              "kind": "line",
              "x1": 960,
              "y1": 40,
              "x2": 930,
              "y2": 40
            },
            {
              "kind": "line",
              "x1": 960,
              "y1": 40,
              "x2": 960,
              "y2": 70
            },
            {
              "kind": "line",
              "x1": 40,
              "y1": 960,
              "x2": 70,
              "y2": 960
            },
            {
              "kind": "line",
              "x1": 40,
              "y1": 960,
              "x2": 40,
              "y2": 930
            },
            {
              "kind": "line",
              "x1": 960,
              "y1": 960,
              "x2": 930,
              "y2": 960
            },
            {
              "kind": "line",
              "x1": 960,
              "y1": 960,
              "x2": 960,
              "y2": 930
            }
          ],
          "stroke": "@accent",
          "strokeWidth": 1.6,
          "fill": "none",
          "opacity": 0.7
        },
        {
          "id": "word",
          "type": "text",
          "content": "{label}",
          "font": "Outfit",
          "weight": 600,
          "size": 72,
          "letterSpacing": -0.03,
          "x": 96,
          "y": 214,
          "maxWidth": 440,
          "fit": "shrink",
          "maxLines": 1,
          "color": "@accent"
        },
        {
          "id": "rule",
          "type": "shape",
          "kind": "line",
          "x1": 98,
          "y1": 256,
          "x2": 300,
          "y2": 256,
          "stroke": "@accent",
          "strokeWidth": 1.4
        },
        {
          "id": "artist",
          "type": "text",
          "content": "{artist}",
          "font": "Geist",
          "weight": 600,
          "size": "{small}",
          "letterSpacing": -0.01,
          "x": 96,
          "y": 318,
          "maxWidth": 440,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@accent"
        },
        {
          "id": "title",
          "type": "text",
          "when": {
            "not": "version"
          },
          "content": "{title}",
          "font": "Geist",
          "weight": 400,
          "size": "{small}",
          "letterSpacing": -0.01,
          "x": 96,
          "y": "{layout.artist.bottom + 38}",
          "maxWidth": 440,
          "maxLines": 2,
          "color": "@accent"
        },
        {
          "id": "titleVersion",
          "type": "text",
          "when": "version",
          "font": "Geist",
          "weight": 400,
          "size": "{small}",
          "letterSpacing": -0.01,
          "x": 96,
          "y": "{layout.artist.bottom + 38}",
          "maxWidth": 460,
          "spans": [
            {
              "content": "{title} ",
              "color": "@accent"
            },
            {
              "content": "({version})",
              "color": "@colors.1"
            }
          ]
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.025
    }
  ]
}