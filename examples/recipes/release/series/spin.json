{
  "$schema": "../../../../schema/recipe.schema.json",
  "name": "spin",
  "description": "Series (v2): a photo spun into a warm abstract around an off-centre point. The photo is spun with covers' spin blur round a seeded centre low and left, then toned through the palette and lifted pale toward the bottom. A hairline circle orbits the spin's centre and the artist and title run round it in tracked caps; the label's wordmark sits small top-right over a short rule. Slots: {photo}, {artist}, {title}, {label}, the palette (colors.0 deep, colors.1 warm, colors.2 pale; text = type). Params: spin (degrees). Fonts: Inter Tight, Urbanist.",
  "requires": [
    "photo"
  ],
  "params": {
    "artist": "Artist",
    "spin": 70,
    "small": 26
  },
  "vars": {
    "cx": {
      "range": [
        340,
        420
      ]
    },
    "cy": {
      "range": [
        560,
        640
      ]
    }
  },
  "layers": [
    {
      "id": "base",
      "type": "solid",
      "color": "@colors.1"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "spun",
          "type": "image",
          "src": "{photo}",
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000,
          "fit": "cover",
          "effects": [
            {
              "kind": "spin",
              "angle": "{spin}",
              "center": [
                {
                  "div": [
                    "$cx",
                    1000
                  ]
                },
                {
                  "div": [
                    "$cy",
                    1000
                  ]
                }
              ]
            },
            {
              "kind": "duotone",
              "colors": [
                "@colors.0",
                "@colors.1",
                "@colors.2"
              ],
              "contrast": 1.1
            },
            {
              "kind": "saturate",
              "amount": 1.15
            }
          ]
        },
        {
          "id": "pale",
          "type": "shape",
          "kind": "rect",
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000,
          "blend": "screen",
          "fill": {
            "type": "linear",
            "colors": [
              "@colors.2",
              "@colors.2"
            ],
            "opacities": [
              0,
              0.6
            ],
            "angle": 180
          }
        },
        {
          "id": "orbit",
          "type": "shape",
          "kind": "circle",
          "cx": "$cx",
          "cy": "$cy",
          "r": 292,
          "fill": "none",
          "stroke": "@text",
          "strokeWidth": 1.3,
          "opacity": 0.7
        },
        {
          "id": "circle",
          "type": "text",
          "content": {
            "upper": "{artist}  \u00b7  {title}  \u00b7  "
          },
          "font": "Inter Tight",
          "weight": 600,
          "size": "{small}",
          "letterSpacing": 0.12,
          "path": {
            "kind": "circle",
            "cx": "$cx",
            "cy": "$cy",
            "r": 312,
            "start": 240
          },
          "color": "@text"
        },
        {
          "id": "wordmark",
          "type": "text",
          "content": "{label}",
          "font": "Urbanist",
          "weight": 700,
          "size": 32,
          "letterSpacing": -0.02,
          "x": 944,
          "y": 84,
          "align": "right",
          "color": "@text"
        },
        {
          "id": "wordRule",
          "type": "shape",
          "kind": "line",
          "x1": 800,
          "y1": 108,
          "x2": 944,
          "y2": 108,
          "stroke": "@text",
          "strokeWidth": 1.3
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.1
    }
  ]
}