{
  "$schema": "../../../../schema/recipe.schema.json",
  "name": "split-ghost",
  "description": "Series (v2): one photo, seen two ways. The photo fills the cover as a duotone in the accent (deep to pale), and a large circle window shows the same photo in its true colour, in register, like a lens held over it, ringed in paper; the catalogue number runs up the left edge in a light weight, in paper; a paper band at the foot carries the artist and title on the left and the mark and the label's name on the right. The photo is defined once and drawn twice (defs/use). Slots: {photo}, {artist}, {title}, {catalog}, {label}, {mark}, the palette (bg = paper, accent = the duotone and the mark, text = type). Fonts: Manrope. {lensX}/{lensY} place the window over the subject.",
  "requires": [
    "photo",
    "mark"
  ],
  "params": {
    "artist": "Artist",
    "catalog": "",
    "small": 30,
    "lensX": 600,
    "lensY": 400
  },
  "vars": {
    "light": {
      "mix": [
        "@accent",
        "@bg",
        0.78
      ]
    },
    "deep": {
      "mix": [
        "@accent",
        "#000000",
        0.5
      ]
    }
  },
  "layers": [
    {
      "id": "paper",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "shots",
          "type": "defs",
          "layers": [
            {
              "id": "shot",
              "type": "image",
              "src": "{photo}",
              "x": 0,
              "y": 0,
              "width": 1000,
              "height": 1000,
              "fit": "cover",
              "focus": "attention"
            }
          ]
        },
        {
          "id": "ghost",
          "type": "group",
          "effects": [
            {
              "kind": "duotone",
              "colors": [
                "$deep",
                "$light"
              ],
              "contrast": 1.1
            }
          ],
          "layers": [
            {
              "id": "ghostUse",
              "type": "use",
              "ref": "shot"
            }
          ]
        },
        {
          "id": "lens",
          "type": "group",
          "clip": [
            {
              "id": "lensShape",
              "type": "shape",
              "kind": "circle",
              "cx": "{lensX}",
              "cy": "{lensY}",
              "r": 290,
              "fill": "#000000"
            }
          ],
          "layers": [
            {
              "id": "lensUse",
              "type": "use",
              "ref": "shot"
            }
          ]
        },
        {
          "id": "lensRing",
          "type": "shape",
          "kind": "circle",
          "cx": "{lensX}",
          "cy": "{lensY}",
          "r": 290,
          "fill": "none",
          "stroke": "@bg",
          "strokeWidth": 7
        },
        {
          "id": "band",
          "type": "shape",
          "kind": "rect",
          "x": 0,
          "y": 852,
          "width": 1000,
          "height": 148,
          "fill": "@bg"
        },
        {
          "id": "number",
          "type": "text",
          "when": "catalog",
          "content": "{catalog}",
          "font": "Manrope",
          "weight": 300,
          "size": 190,
          "letterSpacing": -0.03,
          "x": -800,
          "y": 196,
          "maxWidth": 700,
          "fit": "shrink",
          "maxLines": 1,
          "color": "@bg",
          "transform": {
            "rotate": -90,
            "origin": [
              0,
              0
            ]
          }
        },
        {
          "id": "tick",
          "type": "shape",
          "kind": "line",
          "x1": 58,
          "y1": 40,
          "x2": 58,
          "y2": 100,
          "stroke": "@bg",
          "strokeWidth": 2
        },
        {
          "id": "artist",
          "type": "text",
          "content": "{artist}",
          "font": "Manrope",
          "weight": 700,
          "size": "{small}",
          "letterSpacing": -0.01,
          "x": 56,
          "y": 910,
          "maxWidth": 560,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@text"
        },
        {
          "id": "title",
          "type": "text",
          "content": "{title}",
          "font": "Manrope",
          "weight": 400,
          "size": {
            "mul": [
              "{small}",
              0.8
            ]
          },
          "x": 56,
          "y": 950,
          "maxWidth": 560,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@text"
        },
        {
          "id": "markIcon",
          "type": "icon",
          "markup": "{mark}",
          "x": 904,
          "y": 884,
          "size": 40,
          "color": "@accent"
        },
        {
          "id": "labelName",
          "type": "text",
          "content": {
            "upper": "{label}"
          },
          "font": "Manrope",
          "weight": 700,
          "size": 14,
          "letterSpacing": 0.24,
          "x": 880,
          "y": 912,
          "align": "right",
          "color": "@text"
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.035
    }
  ]
}