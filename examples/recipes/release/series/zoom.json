{
  "$schema": "../../../../schema/recipe.schema.json",
  "name": "zoom",
  "description": "Series (v2): a zoom tunnel. The photo is zoom-blurred with covers' zoom effect toward a point right of centre; the catalogue number is huge in a hairline outline, cropped off the right edge, with an extrusion stepping back into the blur; the label, the artist and the title sit in a small block top-left under a short rule. Slots: {photo}, {catalog}, {label}, {artist}, {title}, the palette (bg = the vignette, accent = the extrusion, text = type). Params: zoom (0\u20130.95). Fonts: Unbounded, Geist.",
  "requires": [
    "photo"
  ],
  "params": {
    "artist": "Artist",
    "catalog": "",
    "small": 28,
    "zoom": 0.5
  },
  "layers": [
    {
      "id": "base",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "zoomed",
          "type": "image",
          "src": "{photo}",
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000,
          "fit": "cover",
          "effects": [
            {
              "kind": "zoom",
              "amount": "{zoom}",
              "center": [
                0.68,
                0.54
              ]
            },
            {
              "kind": "saturate",
              "amount": 1.2
            }
          ]
        },
        {
          "id": "vignette",
          "type": "shape",
          "kind": "rect",
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 1000,
          "fill": {
            "type": "radial",
            "colors": [
              "@bg",
              "@bg"
            ],
            "opacities": [
              0,
              0.75
            ],
            "stops": [
              0.35,
              1
            ],
            "cx": 0.68,
            "cy": 0.54,
            "r": 0.75
          }
        },
        {
          "id": "number",
          "type": "text",
          "when": "catalog",
          "content": "{catalog}",
          "font": "Unbounded",
          "weight": 700,
          "size": 560,
          "letterSpacing": -0.04,
          "x": 1070,
          "y": 760,
          "align": "right",
          "maxWidth": 1000,
          "fit": "shrink",
          "fill": "none",
          "stroke": "@text",
          "strokeWidth": 2.2,
          "extrude": {
            "depth": 40,
            "angle": 200,
            "color": "@accent",
            "to": "@bg",
            "steps": 12
          }
        },
        {
          "id": "label",
          "type": "text",
          "content": {
            "upper": "{label}"
          },
          "font": "Unbounded",
          "weight": 600,
          "size": 20,
          "letterSpacing": 0.2,
          "x": 56,
          "y": 78,
          "color": "@text"
        },
        {
          "id": "rule",
          "type": "shape",
          "kind": "line",
          "x1": 58,
          "y1": 104,
          "x2": 330,
          "y2": 104,
          "stroke": "@text",
          "strokeWidth": 1.3
        },
        {
          "id": "artist",
          "type": "text",
          "content": "{artist}",
          "font": "Geist",
          "weight": 600,
          "size": "{small}",
          "x": 56,
          "y": 150,
          "maxWidth": 380,
          "fit": "shrink",
          "maxLines": 1,
          "color": "@text"
        },
        {
          "id": "title",
          "type": "text",
          "content": "{title}",
          "font": "Geist",
          "weight": 400,
          "size": "{small}",
          "x": 56,
          "y": 186,
          "maxWidth": 380,
          "fit": "shrink",
          "maxLines": 1,
          "color": "@text"
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.07
    }
  ]
}