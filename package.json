{
  "name": "@arraypress/covers",
  "version": "1.4.0",
  "description": "Covers, flyers, posters, release art, social formats and print stationery from one seed and a stack of layers: mesh gradients, grain, riso inks and halftones, knockout and justified type, torn paper, barcodes, safe zones and bleed, as SVG or WebP/PNG/AVIF/JPEG. Recipes are JSON. Runs in Node, browsers and Cloudflare Workers.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js",
      "default": "./src/node.js"
    },
    "./astro": {
      "types": "./src/astro.d.ts",
      "import": "./src/astro.js",
      "default": "./src/astro.js"
    },
    "./package.json": "./package.json",
    "./recipe.schema.json": "./schema/recipe.schema.json",
    "./recipes/*.json": "./recipes/*.json"
  },
  "files": [
    "src",
    "fonts",
    "recipes",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:worker": "COVERS_WORKER=1 node --test tests/worker.test.js",
    "typecheck": "tsc --noEmit",
    "gallery": "node examples/gallery.mjs",
    "schema": "node scripts/schema.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "keywords": [
    "cover-image",
    "featured-image",
    "og-image",
    "mesh-gradient",
    "grain",
    "generative",
    "svg",
    "webp",
    "sharp",
    "harfbuzz",
    "astro",
    "build-time",
    "flyer",
    "poster",
    "release-art",
    "cover-art",
    "spotify",
    "social-media",
    "brand-kit",
    "business-card",
    "print",
    "bleed",
    "riso",
    "halftone",
    "cloudflare-workers",
    "browser"
  ],
  "author": "ArrayPress Limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/covers.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@arraypress/color-utils": "^1.3.0",
    "@logomarks/core": "^0.1.5",
    "@logomarks/image-effects": "^0.1.1",
    "harfbuzzjs": "^1.6.3"
  },
  "peerDependencies": {
    "@arraypress/waveform-gen": "^2.2.0",
    "@iconify-json/lucide": "*",
    "@iconify-json/simple-icons": "*",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "@arraypress/waveform-gen": {
      "optional": true
    },
    "@iconify-json/lucide": {
      "optional": true
    },
    "@iconify-json/simple-icons": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arraypress/waveform-gen": "^2.2.0",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#harfbuzz": {
      "workerd": "./src/platform/no-harfbuzz.js",
      "worker": "./src/platform/no-harfbuzz.js",
      "default": "harfbuzzjs"
    }
  }
}
