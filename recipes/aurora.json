{
  "$schema": "../schema/recipe.schema.json",
  "name": "aurora",
  "description": "A soft mesh of the palette's colours with grain, and an optional title.",
  "layers": [
    {
      "id": "bg",
      "type": "solid"
    },
    {
      "id": "mesh",
      "type": "mesh",
      "count": 5,
      "blur": "13vmax",
      "size": [
        0.32,
        0.56
      ],
      "spread": 0.85
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.085
    },
    {
      "id": "title",
      "type": "text",
      "when": "title",
      "content": "{title}",
      "anchor": "bottom-left",
      "weight": 500,
      "size": {
        "mul": [
          "@u",
          0.066
        ]
      },
      "minSize": {
        "mul": [
          "@u",
          0.048
        ]
      },
      "lineHeight": 1.08,
      "letterSpacing": -0.025,
      "maxLines": 3,
      "label": "{label}"
    }
  ]
}
