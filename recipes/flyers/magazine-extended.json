{
  "$schema": "../../schema/recipe.schema.json",
  "name": "magazine-extended",
  "description": "Pop-zine magazine cover, extended: a wide letter-spaced masthead behind the subject (the photo's cut-out laid back over it), the issue stacked beside it, the name low left and the mark low right in white. Square (release): the masthead is the artist, still behind the subject; the title low left, the mark low right. Re-expressed from the Logomarks scenes lab (ZineCards, 'Cover, extended'). The photo and its cut-out are drawn on an 816-unit square grid (the photo's own height), so they embed at the source's resolution rather than the output's: two full-size embeds at 3000 px overflow librsvg's XML limit.",
  "params": {
    "artist": "Northfold",
    "release": "It Brand",
    "issue": "Nov. 2026",
    "stack": [
      "it",
      "brand"
    ],
    "ink": "#ffffff"
  },
  "layers": [
    {
      "id": "photo",
      "type": "group",
      "viewBox": [
        0,
        0,
        816,
        816
      ],
      "fit": "cover",
      "layers": [
        {
          "type": "image",
          "src": "{photo}",
          "fit": "cover",
          "when": "photo",
          "effects": [
            {
              "kind": "saturate",
              "amount": 0.85
            },
            {
              "kind": "levels",
              "slope": 1.08,
              "intercept": 0
            }
          ],
          "x": 0,
          "y": 0,
          "width": 816,
          "height": 816
        }
      ]
    },
    {
      "id": "poster-back",
      "type": "group",
      "viewBox": [
        0,
        0,
        400,
        500
      ],
      "fit": "contain",
      "when": {
        "not": {
          "aspect": "square"
        }
      },
      "layers": [
        {
          "id": "masthead",
          "type": "text",
          "content": {
            "upper": "{artist}"
          },
          "font": "Unbounded",
          "weight": 900,
          "size": 30.4,
          "letterSpacing": 0.1,
          "x": 20,
          "y": 50,
          "color": "{ink}"
        }
      ]
    },
    {
      "id": "cover-back",
      "type": "group",
      "viewBox": [
        0,
        0,
        400,
        400
      ],
      "fit": "contain",
      "when": {
        "aspect": "square"
      },
      "layers": [
        {
          "id": "masthead",
          "type": "text",
          "content": {
            "upper": "{artist}"
          },
          "font": "Unbounded",
          "weight": 900,
          "size": 40,
          "letterSpacing": 0.1,
          "x": 20,
          "y": 62,
          "width": 360,
          "lengthAdjust": "spacing",
          "color": "{ink}"
        }
      ]
    },
    {
      "id": "cut",
      "type": "group",
      "viewBox": [
        0,
        0,
        816,
        816
      ],
      "fit": "cover",
      "layers": [
        {
          "type": "image",
          "src": "{cutout}",
          "fit": "cover",
          "when": "cutout",
          "effects": [
            {
              "kind": "saturate",
              "amount": 0.85
            },
            {
              "kind": "levels",
              "slope": 1.08,
              "intercept": 0
            }
          ],
          "x": 0,
          "y": 0,
          "width": 816,
          "height": 816
        }
      ]
    },
    {
      "id": "poster",
      "type": "group",
      "viewBox": [
        0,
        0,
        400,
        500
      ],
      "fit": "contain",
      "when": {
        "not": {
          "aspect": "square"
        }
      },
      "layers": [
        {
          "id": "issue",
          "type": "text",
          "content": "{issue}",
          "font": "Geist",
          "weight": 700,
          "size": 13.6,
          "letterSpacing": 0,
          "x": 317,
          "y": 37,
          "color": "{ink}"
        },
        {
          "id": "stack1",
          "type": "text",
          "content": "{stack.0}",
          "font": "Geist",
          "weight": 700,
          "size": 20.8,
          "letterSpacing": 0,
          "x": 317,
          "y": 55.5,
          "color": "{ink}"
        },
        {
          "id": "stack2",
          "type": "text",
          "content": "{stack.1}",
          "font": "Geist",
          "weight": 700,
          "size": 20.8,
          "letterSpacing": 0,
          "x": 317,
          "y": 76.7,
          "color": "{ink}"
        },
        {
          "id": "name",
          "type": "text",
          "content": "{artist}",
          "font": "Geist",
          "weight": 600,
          "size": 36,
          "letterSpacing": -0.03,
          "x": 24,
          "y": 456.7,
          "color": "{ink}"
        },
        {
          "id": "mark",
          "type": "icon",
          "markup": "{mark}",
          "x": 316,
          "y": 415,
          "size": 60,
          "color": "{ink}",
          "when": "mark"
        }
      ]
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        400,
        400
      ],
      "fit": "contain",
      "when": {
        "aspect": "square"
      },
      "layers": [
        {
          "id": "name",
          "type": "text",
          "content": "{release}",
          "font": "Geist",
          "weight": 600,
          "size": 42,
          "letterSpacing": -0.03,
          "x": 22,
          "y": 372,
          "color": "{ink}"
        },
        {
          "id": "mark",
          "type": "icon",
          "markup": "{mark}",
          "x": 314,
          "y": 314,
          "size": 66,
          "color": "{ink}",
          "when": "mark"
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.05,
      "blend": "multiply"
    }
  ]
}