{
  "$schema": "../../schema/recipe.schema.json",
  "name": "solvane",
  "description": "Aura, portrait: the aura-camera look. A cut-out subject wrapped in a glowing cloud (rose, yellow, green, violet orbs on near-black), a faint rose glow round her, the name in thin lowercase behind her head, a small foot line and the mark. The cut-out is drawn at the top level (in % of the canvas) so it's resampled at the output size. With format 'release' it re-composes for a 3000×3000 cover: the subject to the right, the name across the top, the release title to her left. Re-expressed from the Logomarks scenes lab (FlyerCards, 'Aura · portrait').",
  "params": {
    "ground": "#0b0812",
    "ink": "#ffffff",
    "rose": "#ff3d7f",
    "yellow": "#ffcf2e",
    "green": "#3be3a4",
    "violet": "#5a5cff",
    "glow": "#ff78a0",
    "word": "solvane",
    "foot": "aura sessions\n14.02 — 16.02.27",
    "artist": "solvane",
    "release": "iris\nstatic"
  },
  "layers": [
    { "id": "ground", "type": "solid", "color": "{ground}" },
    { "id": "orb1", "type": "mesh", "when": { "not": { "format": "release" } }, "arrangement": "ring", "base": null, "blur": "14.06vw", "blobs": [{ "x": 0.52, "y": 0.3, "r": 0.196, "squash": 1, "rotate": 0, "color": "{rose}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{rose}", "opacity": 0.001 }] },
    { "id": "orb2", "type": "mesh", "when": { "not": { "format": "release" } }, "arrangement": "ring", "base": null, "blur": "11.47vw", "blobs": [{ "x": 0.24, "y": 0.58, "r": 0.152, "squash": 1, "rotate": 0, "color": "{yellow}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{yellow}", "opacity": 0.001 }] },
    { "id": "orb3", "type": "mesh", "when": { "not": { "format": "release" } }, "arrangement": "ring", "base": null, "blur": "11.71vw", "blobs": [{ "x": 0.82, "y": 0.62, "r": 0.156, "squash": 1, "rotate": 0, "color": "{green}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{green}", "opacity": 0.001 }] },
    { "id": "orb4", "type": "mesh", "when": { "not": { "format": "release" } }, "arrangement": "ring", "base": null, "blur": "10.30vw", "blobs": [{ "x": 0.6, "y": 0.06, "r": 0.132, "squash": 1, "rotate": 0, "color": "{violet}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{violet}", "opacity": 0.001 }] },
    { "id": "corb1", "type": "mesh", "when": { "format": "release" }, "arrangement": "ring", "base": null, "blur": "14.06vw", "blobs": [{ "x": 0.7, "y": 0.5, "r": 0.245, "squash": 1, "rotate": 0, "color": "{rose}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{rose}", "opacity": 0.001 }] },
    { "id": "corb2", "type": "mesh", "when": { "format": "release" }, "arrangement": "ring", "base": null, "blur": "12.06vw", "blobs": [{ "x": 0.225, "y": 0.675, "r": 0.2025, "squash": 1, "rotate": 0, "color": "{yellow}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{yellow}", "opacity": 0.001 }] },
    { "id": "corb3", "type": "mesh", "when": { "format": "release" }, "arrangement": "ring", "base": null, "blur": "11.47vw", "blobs": [{ "x": 0.875, "y": 0.75, "r": 0.19, "squash": 1, "rotate": 0, "color": "{green}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{green}", "opacity": 0.001 }] },
    { "id": "corb4", "type": "mesh", "when": { "format": "release" }, "arrangement": "ring", "base": null, "blur": "10.89vw", "blobs": [{ "x": 0.575, "y": 0.075, "r": 0.1775, "squash": 1, "rotate": 0, "color": "{violet}" }, { "x": 0.5, "y": 0.5, "r": 0.75, "color": "{violet}", "opacity": 0.001 }] },
    {
      "id": "behind",
      "type": "group",
      "when": { "not": { "format": "release" } },
      "viewBox": [0, 0, 400, 500],
      "fit": "contain",
      "layers": [
        { "id": "word", "type": "text", "content": "{word}", "font": "Geist", "weight": 250, "size": 88, "letterSpacing": -0.07, "x": 200, "y": 95.2, "align": "center", "color": "{ink}" }
      ]
    },
    {
      "id": "subject",
      "type": "image",
      "when": { "all": ["cutout", { "not": { "format": "release" } }] },
      "src": "{cutout}",
      "x": "-42.35%",
      "y": "20%",
      "width": "178.43%",
      "height": "80%",
      "fit": "cover",
      "effects": [{ "kind": "glow", "color": "{glow}", "opacity": 0.35, "blur": "1.5vw" }]
    },
    {
      "id": "poster",
      "type": "group",
      "when": { "not": { "format": "release" } },
      "viewBox": [0, 0, 400, 500],
      "fit": "contain",
      "layers": [
        { "id": "foot", "type": "text", "content": "{foot}", "font": "Geist", "weight": 400, "size": 11.2, "letterSpacing": 0, "lineHeight": 1.3, "x": 24, "y": 457.1, "color": "{ink}" },
        { "id": "mark", "type": "icon", "markup": "{mark}", "x": 340, "y": 439, "size": 36, "color": "{ink}", "when": "mark" }
      ]
    },
    {
      "id": "coverBehind",
      "type": "group",
      "when": { "format": "release" },
      "viewBox": [0, 0, 400, 400],
      "fit": "contain",
      "layers": [
        { "id": "artist", "type": "text", "content": "{artist}", "font": "Geist", "weight": 250, "size": 122, "letterSpacing": -0.07, "x": 200, "y": 112, "align": "center", "color": "{ink}" }
      ]
    },
    {
      "id": "coverSubject",
      "type": "image",
      "when": { "all": ["cutout", { "format": "release" }] },
      "src": "{cutout}",
      "x": "-8.25%",
      "y": "29%",
      "width": "147.25%",
      "height": "82.5%",
      "fit": "cover",
      "effects": [{ "kind": "glow", "color": "{glow}", "opacity": 0.35, "blur": "1.5vw" }]
    },
    {
      "id": "cover",
      "type": "group",
      "when": { "format": "release" },
      "viewBox": [0, 0, 400, 400],
      "fit": "contain",
      "layers": [
        { "id": "mark", "type": "icon", "markup": "{mark}", "x": 22, "y": 250, "size": 34, "color": "{ink}", "when": "mark" },
        { "id": "title", "type": "text", "content": "{release}", "font": "Geist", "weight": 400, "size": 42, "letterSpacing": -0.04, "lineHeight": 0.98, "x": 20, "y": 334, "color": "{ink}" }
      ]
    },
    { "id": "grain", "type": "grain", "amount": 0.12, "size": 1.5, "blend": "overlay" },
    { "id": "speck", "type": "grain", "amount": 0.025, "size": 1.5, "blend": "screen" },
    { "id": "print", "type": "grain", "amount": 0.04, "size": 1.5, "blend": "multiply" }
  ]
}
