{
  "$schema": "../../schema/recipe.schema.json",
  "name": "terminal-poster",
  "description": "Terminal launch poster: acid lime (any ink) on black, set like a HUD readout. A lime bar across the top with the terminal line, a small nested-square icon and a seeded code (480-A<3.56.7.128>); INIT in outline type; a small mono log under it (CORE REVIEW [START], CORE 1–6 … OK in three columns with dot leaders, CORES STABLE, RESULTS [PRNTD]); a big lime panel with chamfered corners, a tab and a notch along its top and foot, holding the mark large in the ground colour (or, with pixel: true, rastered into square cells, @logomarks/core's pixelCells), tiny serials mirrored in two corners and a 3 × 3 dot grid; a row of HUD glyphs (a barcode, a crosshair, an ×, a square target, two seeded two-digit numbers); the headline huge in a lime panel, fitted to its width; and a notched lime footer with the name. Short ticks run down both margins. The display face is font (Rubik Mono One by default: wide, mono, OFL; register it, or it falls back to Inter); the small type is mono (Space Mono). Drawn on a 400-wide grid as tall as the canvas, so it sets at 4:5, 1:1, 9:16 and A-series portrait alike; the code, serial and numbers follow the seed.",
  "params": { "name": "Kestrel", "headline": "Launch", "init": "Init", "terminal": "Public access terminal", "code": "", "serial": "", "log": ["Core review [start]", "Cores stable", "Results [prntd]"], "core": "Core", "status": "OK", "signoff": "End of line", "pixel": false, "cells": 20, "font": "Rubik Mono One", "mono": "Space Mono", "ink": "#c8ff00", "ground": "#000000" },
  "vars": {
    "h": { "mul": [400, { "div": ["@height", "@width"] }] },
    "tall": { "min": [1.45, { "max": [0.9, { "div": ["$h", 500] }] }] },
    "pt": 131,
    "fb": { "sub": ["$h", 10] },
    "ft": { "sub": ["$h", 24] },
    "hb": { "sub": ["$h", 32] },
    "ht": { "sub": [{ "sub": ["$h", 32] }, { "mul": [66, "$tall"] }] },
    "gy": { "sub": ["$ht", 30] },
    "pb": { "sub": ["$ht", 42] },
    "c1": { "int": [100, 999] },
    "c2": { "pick": ["A", "B", "C", "D", "E", "F", "H", "K", "M", "R", "X"] },
    "c3": { "int": [1, 9] },
    "c4": { "int": [10, 99] },
    "c5": { "int": [1, 9] },
    "c6": { "int": [100, 255] },
    "s1": { "int": [1000, 9999] },
    "s2": { "pick": ["A", "C", "K", "R", "T", "X", "Z"] },
    "s3": { "int": [10, 99] },
    "s4": { "int": [10, 99] },
    "v1": { "int": [1, 9] },
    "v2": { "int": [10, 99] },
    "n1": { "int": [10, 99] },
    "n2": { "int": [10, 99] }
  },
  "layers": [
    { "id": "ground", "type": "solid", "color": "{ground}" },
    {
      "id": "poster",
      "type": "group",
      "viewBox": [0, 0, 400, "$h"],
      "fit": "contain",
      "layers": [
        { "id": "ticks", "type": "repeat", "count": { "floor": { "div": [{ "sub": ["$h", 28] }, 6] } }, "x": 0, "y": 14, "step": [0, 6], "layer": { "type": "shape", "items": [{ "kind": "line", "x1": 5, "y1": 0, "x2": "{#i % 5 ? 8 : 10}", "y2": 0 }, { "kind": "line", "x1": 395, "y1": 0, "x2": "{#i % 5 ? 392 : 390}", "y2": 0 }], "stroke": "{ink}", "strokeWidth": 0.6, "opacity": 0.7 } },
        { "id": "band", "type": "shape", "kind": "polygon", "points": [[16, 14], [384, 14], [384, 26], [378, 32], [16, 32]], "fill": "{ink}" },
        { "id": "icon", "type": "shape", "items": [{ "kind": "rect", "x": 21.5, "y": 17.5, "width": 11, "height": 11, "fill": "none", "stroke": "{ground}", "strokeWidth": 1 }, { "kind": "rect", "x": 24.5, "y": 20.5, "width": 5, "height": 5, "fill": "{ground}" }], "fill": "{ground}" },
        { "id": "terminal", "type": "text", "content": "{terminal}", "font": "{mono}", "weight": 700, "size": 7.5, "letterSpacing": 0.02, "x": 38, "y": 26, "maxWidth": 200, "maxLines": 1, "color": "{ground}", "transform": "uppercase" },
        { "id": "code", "type": "text", "content": { "if": "code", "then": "{code}", "else": { "join": [["$c1", "-", "$c2", "<", "$c3", ".", "$c4", ".", "$c5", ".", "$c6", ">"], ""] } }, "font": "{mono}", "weight": 700, "size": 7.5, "letterSpacing": 0.02, "x": 376, "y": 26, "maxWidth": 130, "maxLines": 1, "color": "{ground}", "align": "right" },
        { "id": "init", "type": "text", "content": "{init}", "when": "init", "transform": "uppercase", "font": "{font}", "weight": 700, "size": 34, "letterSpacing": 0.04, "x": 15, "y": 72, "maxWidth": 200, "maxLines": 1, "fill": "none", "stroke": "{ink}", "strokeWidth": 0.8, "color": "{ink}" },
        { "id": "boot", "type": "text", "content": { "join": [["SYS", "$v1", ".", "$v2", " // ", "{name}"], ""] }, "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 384, "y": 52, "maxWidth": 170, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase", "opacity": 0.75 },
        { "id": "rule", "type": "shape", "kind": "line", "x1": 214, "y1": 61, "x2": 384, "y2": 61, "stroke": "{ink}", "strokeWidth": 0.6, "dash": [1.2, 1.6] },
        { "id": "mode", "type": "text", "content": { "join": [["RUN ", "$n1", "/", "$n2", " ▶"], ""] }, "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 384, "y": 72, "maxWidth": 170, "maxLines": 1, "color": "{ink}", "align": "right", "opacity": 0.75 },
        { "id": "start", "type": "text", "content": "{log.0}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 16, "y": 88, "maxWidth": 170, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "core1", "type": "text", "content": "{core} 1", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 16, "y": 99, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok1", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 134, "y": 99, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        { "id": "core2", "type": "text", "content": "{core} 2", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 141, "y": 99, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok2", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 259, "y": 99, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        { "id": "core3", "type": "text", "content": "{core} 3", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 266, "y": 99, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok3", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 384, "y": 99, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        { "id": "core4", "type": "text", "content": "{core} 4", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 16, "y": 108, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok4", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 134, "y": 108, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        { "id": "core5", "type": "text", "content": "{core} 5", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 141, "y": 108, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok5", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 259, "y": 108, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        { "id": "core6", "type": "text", "content": "{core} 6", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 266, "y": 108, "maxWidth": 70, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "ok6", "type": "text", "content": "{status}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 384, "y": 108, "maxWidth": 40, "maxLines": 1, "color": "{ink}", "align": "right", "transform": "uppercase" },
        {
          "id": "leaders",
          "type": "shape",
          "items": [
            { "kind": "line", "x1": "{layout.core1.right + 3}", "y1": 98.6, "x2": "{layout.ok1.left - 3}", "y2": 98.6 },
            { "kind": "line", "x1": "{layout.core2.right + 3}", "y1": 98.6, "x2": "{layout.ok2.left - 3}", "y2": 98.6 },
            { "kind": "line", "x1": "{layout.core3.right + 3}", "y1": 98.6, "x2": "{layout.ok3.left - 3}", "y2": 98.6 },
            { "kind": "line", "x1": "{layout.core4.right + 3}", "y1": 107.6, "x2": "{layout.ok4.left - 3}", "y2": 107.6 },
            { "kind": "line", "x1": "{layout.core5.right + 3}", "y1": 107.6, "x2": "{layout.ok5.left - 3}", "y2": 107.6 },
            { "kind": "line", "x1": "{layout.core6.right + 3}", "y1": 107.6, "x2": "{layout.ok6.left - 3}", "y2": 107.6 }
          ],
          "stroke": "{ink}",
          "strokeWidth": 0.9,
          "dash": [0.9, 1.5]
        },
        { "id": "stable", "type": "text", "content": "{log.1}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 16, "y": 119, "maxWidth": 170, "maxLines": 1, "color": "{ink}", "transform": "uppercase" },
        { "id": "results", "type": "text", "content": "{log.2}", "font": "{mono}", "weight": 700, "size": 6, "letterSpacing": 0.02, "x": 384, "y": 119, "maxWidth": 170, "maxLines": 1, "color": "{ink}", "transform": "uppercase", "align": "right" },
        {
          "id": "panel",
          "type": "shape",
          "kind": "polygon",
          "points": [
            [16, { "add": ["$pt", 8] }],
            [24, "$pt"],
            [60, "$pt"],
            [65, { "add": ["$pt", -5] }],
            [136, { "add": ["$pt", -5] }],
            [141, "$pt"],
            [250, "$pt"],
            [255, { "add": ["$pt", 5] }],
            [300, { "add": ["$pt", 5] }],
            [305, "$pt"],
            [384, "$pt"],
            [384, { "add": ["$pb", -8] }],
            [376, "$pb"],
            [340, "$pb"],
            [335, { "add": ["$pb", 5] }],
            [264, { "add": ["$pb", 5] }],
            [259, "$pb"],
            [150, "$pb"],
            [145, { "add": ["$pb", -5] }],
            [100, { "add": ["$pb", -5] }],
            [95, "$pb"],
            [16, "$pb"]
          ],
          "fill": "{ink}"
        },
        { "id": "mark", "type": "outline", "when": { "all": ["mark", { "not": "pixel" }] }, "markup": "{mark}", "lines": 0, "x": 40, "y": { "add": ["$pt", 22] }, "width": 320, "height": { "sub": [{ "sub": ["$pb", "$pt"] }, 44] }, "color": "{ground}" },
        { "id": "pixels", "type": "mosaic", "when": { "all": ["mark", "pixel"] }, "markup": "{mark}", "x": 40, "y": { "add": ["$pt", 22] }, "width": 320, "height": { "sub": [{ "sub": ["$pb", "$pt"] }, 44] }, "cells": "{cells}", "drop": 0, "gap": 0.08, "color": "{ground}" },
        { "id": "serial", "type": "text", "content": { "if": "serial", "then": "{serial}", "else": { "join": [["SN.", "$s1", "-", "$s2", "$s3", " / LOT ", "$s4"], ""] } }, "font": "{mono}", "weight": 700, "size": 5, "letterSpacing": 0.02, "x": 26, "y": { "add": ["$pt", 15] }, "maxWidth": 120, "maxLines": 1, "color": "{ground}" },
        {
          "id": "mirror",
          "type": "group",
          "transform": { "rotate": 180, "origin": [374, { "sub": ["$pb", 15] }] },
          "layers": [{ "id": "serialMirror", "type": "text", "content": { "if": "serial", "then": "{serial}", "else": { "join": [["SN.", "$s1", "-", "$s2", "$s3", " / LOT ", "$s4"], ""] } }, "font": "{mono}", "weight": 700, "size": 5, "letterSpacing": 0.02, "x": 374, "y": { "sub": ["$pb", 15] }, "maxWidth": 120, "maxLines": 1, "color": "{ground}" }]
        },
        {
          "id": "dots",
          "type": "shape",
          "fill": "{ground}",
          "items": [
            { "kind": "circle", "cx": 362, "cy": { "add": ["$pt", 10] }, "r": 1.1 },
            { "kind": "circle", "cx": 368, "cy": { "add": ["$pt", 10] }, "r": 1.1 },
            { "kind": "circle", "cx": 374, "cy": { "add": ["$pt", 10] }, "r": 1.1 },
            { "kind": "circle", "cx": 362, "cy": { "add": ["$pt", 16] }, "r": 1.1 },
            { "kind": "circle", "cx": 368, "cy": { "add": ["$pt", 16] }, "r": 1.1 },
            { "kind": "circle", "cx": 374, "cy": { "add": ["$pt", 16] }, "r": 1.1 },
            { "kind": "circle", "cx": 362, "cy": { "add": ["$pt", 22] }, "r": 1.1 },
            { "kind": "circle", "cx": 368, "cy": { "add": ["$pt", 22] }, "r": 1.1 },
            { "kind": "circle", "cx": 374, "cy": { "add": ["$pt", 22] }, "r": 1.1 }
          ]
        },
        { "id": "barcode", "type": "barcode", "kind": "seeded", "x": 16, "y": "$gy", "width": 76, "height": 18, "color": "{ink}" },
        {
          "id": "glyphs",
          "type": "shape",
          "stroke": "{ink}",
          "strokeWidth": 1,
          "fill": "none",
          "items": [
            { "kind": "circle", "cx": 116, "cy": { "add": ["$gy", 9] }, "r": 6 },
            { "kind": "line", "x1": 106, "y1": { "add": ["$gy", 9] }, "x2": 126, "y2": { "add": ["$gy", 9] } },
            { "kind": "line", "x1": 116, "y1": { "add": ["$gy", -1] }, "x2": 116, "y2": { "add": ["$gy", 19] } },
            { "kind": "line", "x1": 140, "y1": { "add": ["$gy", 3] }, "x2": 152, "y2": { "add": ["$gy", 15] } },
            { "kind": "line", "x1": 152, "y1": { "add": ["$gy", 3] }, "x2": 140, "y2": { "add": ["$gy", 15] } },
            { "kind": "rect", "x": 166.5, "y": { "add": ["$gy", 2.5] }, "width": 13, "height": 13 },
            { "kind": "rect", "x": 171, "y": { "add": ["$gy", 7] }, "width": 4, "height": 4, "fill": "{ink}", "stroke": "none" }
          ]
        },
        { "id": "readout", "type": "text", "content": [{ "join": [["X ", "$c4", ".", "$c6"], ""] }, { "join": [["Y ", "$s3", ".", "$c1"], ""] }], "font": "{mono}", "weight": 700, "size": 5.5, "letterSpacing": 0.02, "x": 196, "y": { "add": ["$gy", 7.5] }, "maxWidth": 60, "maxLines": 2, "color": "{ink}", "lineHeight": 1.45, "opacity": 0.75 },
        { "id": "n1", "type": "text", "content": "$n1", "font": "{font}", "weight": 700, "size": 15, "letterSpacing": 0, "x": 330, "y": { "add": ["$gy", 16.5] }, "align": "right", "maxWidth": 60, "maxLines": 1, "color": "{ink}" },
        { "id": "slash", "type": "shape", "kind": "line", "x1": 340, "y1": { "add": ["$gy", 17] }, "x2": 348, "y2": { "add": ["$gy", 1] }, "stroke": "{ink}", "strokeWidth": 1 },
        { "id": "n2", "type": "text", "content": "$n2", "font": "{font}", "weight": 700, "size": 15, "letterSpacing": 0, "x": 384, "y": { "add": ["$gy", 16.5] }, "align": "right", "maxWidth": 60, "maxLines": 1, "color": "{ink}" },
        { "id": "headPanel", "type": "shape", "kind": "polygon", "points": [[16, "$ht"], [22, "$ht"], [26, { "add": ["$ht", -4] }], [84, { "add": ["$ht", -4] }], [88, "$ht"], [372, "$ht"], [384, { "add": ["$ht", 12] }], [384, "$hb"], [16, "$hb"]], "fill": "{ink}" },
        {
          "id": "stretch",
          "type": "group",
          "transform": { "scale": [1, "$tall"], "origin": [200, { "div": [{ "add": ["$ht", "$hb"] }, 2] }] },
          "layers": [
            {
              "id": "headline",
              "type": "text",
              "content": "{headline}",
              "when": "headline",
              "transform": "uppercase",
              "font": "{font}",
              "weight": 800,
              "size": 80,
              "lineHeight": 1,
              "letterSpacing": -0.01,
              "fit": "width",
              "maxWidth": 352,
              "maxHeight": { "div": [{ "sub": [{ "sub": ["$hb", "$ht"] }, 18] }, "$tall"] },
              "maxLines": 1,
              "anchor": "center",
              "margin": 0,
              "offset": { "x": 0, "y": { "sub": [{ "div": [{ "add": ["$ht", "$hb"] }, 2] }, { "div": ["$h", 2] }] } },
              "color": "{ground}"
            }
          ]
        },
        { "id": "footer", "type": "shape", "kind": "polygon", "points": [[16, "$ft"], [206, "$ft"], [211, { "add": ["$ft", 4] }], [252, { "add": ["$ft", 4] }], [257, "$ft"], [300, "$ft"], [306, { "add": ["$ft", 6] }], [384, { "add": ["$ft", 6] }], [384, "$fb"], [16, "$fb"]], "fill": "{ink}" },
        { "id": "name", "type": "text", "content": "{name}", "font": "{mono}", "weight": 700, "size": 7, "letterSpacing": 0.02, "x": 22, "y": { "sub": ["$h", 14] }, "maxWidth": 180, "maxLines": 1, "color": "{ground}", "transform": "uppercase", "when": "name" },
        { "id": "signoff", "type": "text", "content": "{signoff}", "font": "{mono}", "weight": 700, "size": 5.5, "letterSpacing": 0.02, "x": 378, "y": { "sub": ["$h", 12] }, "maxWidth": 76, "maxLines": 1, "color": "{ground}", "transform": "uppercase", "align": "right", "when": "signoff" }
      ]
    }
  ]
}
