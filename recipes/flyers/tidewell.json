{
  "$schema": "../../schema/recipe.schema.json",
  "name": "tidewell",
  "description": "Riso, orange + teal: two misregistered drums on cream paper. The mark in solid teal over an orange halftone fade (a black-to-white ramp screened at 75°, dots growing toward the top), so it prints dark where they cross; a chunky title in teal between two rules, an italic serif word and a tracklist in orange, a catalogue line in the foot. With format 'release' it re-composes for a 3000×3000 cover: the mark over the fade, the name, and the release title as the italic word. Re-expressed from the Logomarks scenes lab (FlyerCards, 'Riso · orange + teal').",
  "params": {
    "paper": "#f4efe4",
    "orange": "#ff6c2f",
    "teal": "#00838a",
    "name": "Tidewell",
    "word": "tapes",
    "sides": [
      [{ "content": "Side A", "weight": 800 }, { "content": "Side B", "weight": 800 }],
      ["Low tide, high noon", "Kelp radio"],
      ["Salt in the wires", "Harbour lights, slow"]
    ],
    "catalogue": "TW—012",
    "details": " · cassette, 40 min · out 3 March",
    "url": "tidewell-tapes.net",
    "artist": "Tidewell",
    "release": "Kelp Radio"
  },
  "layers": [
    { "id": "paper", "type": "solid", "color": "{paper}" },
    { "id": "fibres", "type": "texture", "kind": "paper" },
    {
      "id": "poster",
      "type": "group",
      "when": { "not": { "format": "release" } },
      "viewBox": [0, 0, 400, 500],
      "fit": "contain",
      "layers": [
        {
          "id": "orange",
          "type": "group",
          "blend": "multiply",
          "transform": { "translate": [-1.4, 1.6], "rotate": -0.3, "origin": [200, 250] },
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "fade", "type": "shape", "kind": "rect", "x": 16, "y": 16, "width": 368, "height": 300, "fill": { "type": "linear", "angle": 180, "colors": ["#000000", "#ffffff"] }, "effects": [{ "kind": "halftone", "ink": "{orange}", "cell": 6, "angle": 75, "contrast": 1.15, "lift": -0.05 }] },
            { "id": "word", "type": "text", "content": "{word}", "font": "Instrument Serif", "style": "italic", "weight": 400, "size": 60, "letterSpacing": 0, "x": 386, "y": 456, "align": "right", "color": "{orange}" },
            { "id": "sides", "type": "table", "font": "Bricolage Grotesque", "weight": 600, "size": 10, "color": "{orange}", "y": 436, "rowHeight": 12, "columns": [{ "x": 16 }, { "x": 124 }], "rows": "{sides}" }
          ]
        },
        {
          "id": "teal",
          "type": "group",
          "blend": "multiply",
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "mark", "type": "icon", "markup": "{mark}", "x": 74, "y": 48, "size": 252, "color": "{teal}", "when": "mark" },
            { "id": "title", "type": "text", "content": "{name}", "font": "Bricolage Grotesque", "weight": 800, "size": 112, "letterSpacing": -0.0446, "x": 15, "y": 396, "width": 370, "color": "{teal}" },
            { "id": "rules", "type": "shape", "stroke": "{teal}", "items": [{ "kind": "line", "x1": 16, "y1": 414, "x2": 384, "y2": 414, "strokeWidth": 1.2 }, { "kind": "line", "x1": 16, "y1": 474, "x2": 384, "y2": 474, "strokeWidth": 0.6 }] },
            { "id": "foot", "type": "table", "font": "Bricolage Grotesque", "weight": 600, "size": 9, "color": "{teal}", "y": 488, "columns": [{ "x": 16, "weight": 800 }, { "x": 52.47 }, { "x": 384, "align": "right" }], "rows": [["{catalogue}", "{details}", "{url}"]] }
          ]
        }
      ]
    },
    {
      "id": "cover",
      "type": "group",
      "when": { "format": "release" },
      "viewBox": [0, 0, 400, 400],
      "fit": "contain",
      "layers": [
        {
          "id": "orange",
          "type": "group",
          "blend": "multiply",
          "transform": { "translate": [-1.4, 1.6], "rotate": -0.3, "origin": [200, 200] },
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "fade", "type": "shape", "kind": "rect", "x": 16, "y": 16, "width": 368, "height": 228, "fill": { "type": "linear", "angle": 180, "colors": ["#000000", "#ffffff"] }, "effects": [{ "kind": "halftone", "ink": "{orange}", "cell": 6, "angle": 75, "contrast": 1.15, "lift": -0.05 }] },
            { "id": "title", "type": "text", "content": "{release}", "font": "Instrument Serif", "style": "italic", "weight": 400, "size": 56, "letterSpacing": 0, "x": 386, "y": 388, "align": "right", "color": "{orange}" }
          ]
        },
        {
          "id": "teal",
          "type": "group",
          "blend": "multiply",
          "effects": [{ "kind": "wear", "rough": 1.3 }],
          "layers": [
            { "id": "mark", "type": "icon", "markup": "{mark}", "x": 100, "y": 28, "size": 200, "color": "{teal}", "when": "mark" },
            { "id": "artist", "type": "text", "content": "{artist}", "font": "Bricolage Grotesque", "weight": 800, "size": 112, "letterSpacing": -0.0446, "x": 15, "y": 320, "width": 370, "color": "{teal}" },
            { "id": "rule", "type": "shape", "kind": "line", "x1": 16, "y1": 336, "x2": 384, "y2": 336, "stroke": "{teal}", "strokeWidth": 1.2 }
          ]
        }
      ]
    },
    { "id": "print", "type": "grain", "amount": 0.04, "size": 1.5, "blend": "multiply" }
  ]
}
