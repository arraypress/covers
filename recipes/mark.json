{
  "$schema": "../schema/recipe.schema.json",
  "name": "mark",
  "description": "One icon, centred, on the accent or an accent gradient: white whenever white clears 3:1 (WCAG 1.4.11, non-text) against everything under it, else near-black.",
  "params": {
    "background": "solid",
    "angle": 135,
    "colors": null,
    "size": "24vmin",
    "iconColor": "auto"
  },
  "vars": {
    "gradient": {
      "if": "colors",
      "then": "{colors}",
      "else": [
        "@accent",
        {
          "mix": [
            "@accent",
            "@colors.1",
            0.5,
            "oklch"
          ]
        }
      ]
    },
    "ink": {
      "if": {
        "iconColor": "auto"
      },
      "then": {
        "if": {
          "background": "gradient"
        },
        "then": {
          "readable": [
            {
              "gradientUnder": [
                "$gradient",
                "{angle}",
                "{size}"
              ]
            },
            3,
            "white"
          ]
        },
        "else": {
          "readable": [
            "@accent",
            3,
            "white"
          ]
        }
      },
      "else": {
        "if": {
          "iconColor": "white"
        },
        "then": "#ffffff",
        "else": {
          "if": {
            "iconColor": "black"
          },
          "then": "#111111",
          "else": "{iconColor}"
        }
      }
    },
    "type": {
      "if": {
        "background": "gradient"
      },
      "then": {
        "readable": [
          "$gradient",
          4.5,
          "$ink"
        ]
      },
      "else": {
        "readable": [
          "@accent",
          4.5,
          "$ink"
        ]
      }
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "solid",
      "when": {
        "background": "solid"
      },
      "color": "@accent"
    },
    {
      "id": "bg",
      "type": "linear",
      "when": {
        "background": "gradient"
      },
      "angle": "{angle}",
      "colors": "$gradient"
    },
    {
      "id": "icon",
      "type": "icon",
      "name": "{icon}",
      "path": {
        "if": {
          "not": "icon"
        },
        "then": "M12 2c.4 4.9 2.1 7.6 7 8.6l3 .4-3 .4c-4.9 1-6.6 3.7-7 8.6-.4-4.9-2.1-7.6-7-8.6L2 11l3-.4c4.9-1 6.6-3.7 7-8.6Z"
      },
      "viewBox": {
        "if": {
          "not": "icon"
        },
        "then": [
          0,
          0,
          24,
          24
        ]
      },
      "size": "{size}",
      "color": "$ink"
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.03
    },
    {
      "id": "title",
      "type": "text",
      "when": "title",
      "content": "{title}",
      "anchor": "bottom-left",
      "weight": 500,
      "size": {
        "mul": [
          "@u",
          0.066
        ]
      },
      "minSize": {
        "mul": [
          "@u",
          0.048
        ]
      },
      "lineHeight": 1.08,
      "letterSpacing": -0.025,
      "maxLines": 3,
      "label": {
        "if": "label",
        "then": {
          "color": "$type",
          "content": "{label}"
        }
      },
      "color": "$type"
    }
  ]
}
