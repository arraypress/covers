{
  "$schema": "../../schema/recipe.schema.json",
  "name": "aura",
  "description": "Gradient minimal: a soft aura of the palette, two or three blurred fields glowing out of the page colour under heavy grain, and the artist and title set small and centred top and bottom. Slots: {name} (artist), {title} (release), the palette (bg, colors; text). Fonts: Geist (register them as TTF/WOFF; WOFF2 can't be outlined).",
  "vars": {
    "ax": {
      "range": [
        380,
        620
      ]
    },
    "ay": {
      "range": [
        420,
        560
      ]
    },
    "bx": {
      "range": [
        200,
        800
      ]
    }
  },
  "layers": [
    {
      "id": "page",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "halo",
          "type": "shape",
          "kind": "circle",
          "cx": "$ax",
          "cy": "$ay",
          "r": 330,
          "fill": "@colors.0",
          "effects": [
            {
              "kind": "blur",
              "radius": 150
            }
          ]
        },
        {
          "id": "second",
          "type": "shape",
          "kind": "ellipse",
          "cx": "$bx",
          "cy": 330,
          "rx": 260,
          "ry": 200,
          "fill": "@colors.1",
          "opacity": 0.8,
          "effects": [
            {
              "kind": "blur",
              "radius": 140
            }
          ]
        },
        {
          "id": "core",
          "type": "shape",
          "kind": "circle",
          "cx": "$ax",
          "cy": {
            "add": [
              "$ay",
              40
            ]
          },
          "r": 150,
          "fill": "@colors.2",
          "opacity": 0.75,
          "effects": [
            {
              "kind": "blur",
              "radius": 110
            }
          ]
        },
        {
          "id": "name",
          "type": "text",
          "content": "{name}",
          "font": "Geist",
          "weight": 500,
          "size": 90,
          "letterSpacing": -0.02,
          "x": 500,
          "y": 130,
          "align": "center",
          "maxWidth": 900,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@text"
        },
        {
          "id": "title",
          "type": "text",
          "content": "{title}",
          "font": "Geist",
          "weight": 400,
          "size": 90,
          "letterSpacing": -0.02,
          "x": 500,
          "y": 935,
          "align": "center",
          "maxWidth": 900,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@text",
          "opacity": 0.86
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.13,
      "size": 1.3
    }
  ]
}
