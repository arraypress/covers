{
  "$schema": "../../schema/recipe.schema.json",
  "name": "riso",
  "description": "Risograph, one ink: the photo halftoned in a single ink on cream stock inside a printed border, the artist and title under it in the same ink, all of it worn like a drum print. Slots: {name} (artist), {title} (release), {photo} (or {cutout}), the palette (accent = the ink; any riso ink by name works, e.g. \"riso:blue\"), `paper`. Fonts: Bricolage Grotesque (register them as TTF/WOFF; WOFF2 can't be outlined).",
  "requires": [
    "photo"
  ],
  "params": {
    "paper": "#f2ede2",
    "focus": "center"
  },
  "layers": [
    {
      "id": "paper",
      "type": "solid",
      "color": "{paper}"
    },
    {
      "id": "fibres",
      "type": "texture",
      "kind": "paper"
    },
    {
      "id": "ink",
      "type": "group",
      "blend": "multiply",
      "effects": [
        {
          "kind": "wear",
          "rough": "0.12vmin",
          "uneven": 0.35
        }
      ],
      "layers": [
        {
          "id": "print",
          "type": "image",
          "src": "{photo}",
          "x": "4%",
          "y": "4%",
          "width": "92%",
          "height": "68%",
          "fit": "cover",
          "focus": "{focus}",
          "effects": [
            {
              "kind": "halftone",
              "ink": "@accent",
              "cell": "0.8vmin",
              "angle": 22,
              "contrast": 1.2,
              "lift": 0
            }
          ]
        },
        {
          "id": "type",
          "type": "group",
          "viewBox": [
            0,
            0,
            1000,
            1000
          ],
          "fit": "cover",
          "layers": [
            {
              "id": "name",
              "type": "text",
              "content": "{name}",
              "font": "Bricolage Grotesque",
              "weight": 800,
              "size": 118,
              "letterSpacing": -0.045,
              "x": 36,
              "y": 836,
              "maxWidth": 930,
              "maxLines": 1,
              "fit": "shrink",
              "color": "@accent"
            },
            {
              "id": "title",
              "type": "text",
              "content": "{title}",
              "font": "Bricolage Grotesque",
              "weight": 500,
              "size": 96,
              "letterSpacing": -0.035,
              "x": 38,
              "y": 948,
              "maxWidth": 930,
              "maxLines": 1,
              "fit": "shrink",
              "color": "@accent"
            }
          ]
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.07,
      "blend": "multiply"
    }
  ]
}
