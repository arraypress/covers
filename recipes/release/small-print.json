{
  "$schema": "../../schema/recipe.schema.json",
  "name": "small-print",
  "description": "Photo, full bleed, nothing else but the artist and title set small in white in the bottom-left corner, over a faint scrim and a soft shadow so they read on any photo. Slots: {name} (artist), {title} (release), {photo}, `focus` (the crop: center, left, right, attention). Fonts: Inter Tight (register them as TTF/WOFF; WOFF2 can't be outlined).",
  "requires": [
    "photo"
  ],
  "params": {
    "focus": "center",
    "ink": "#ffffff"
  },
  "layers": [
    {
      "id": "photo",
      "type": "image",
      "src": "{photo}",
      "fit": "cover",
      "focus": "{focus}"
    },
    {
      "id": "scrim",
      "type": "linear",
      "angle": 180,
      "colors": [
        "#000000",
        "#000000"
      ],
      "opacities": [
        0,
        0.38
      ],
      "opacity": 1,
      "mask": [
        {
          "type": "linear",
          "angle": 180,
          "colors": [
            "#000000",
            "#000000",
            "#ffffff"
          ]
        }
      ]
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "name",
          "type": "text",
          "content": "{name}",
          "font": "Inter Tight",
          "weight": 600,
          "size": 86,
          "letterSpacing": -0.025,
          "x": 48,
          "y": 862,
          "maxWidth": 904,
          "maxLines": 1,
          "fit": "shrink",
          "color": "{ink}",
          "effects": [
            {
              "kind": "shadow",
              "x": 0,
              "y": 2,
              "blur": 10,
              "color": "#000000",
              "opacity": 0.35
            }
          ]
        },
        {
          "id": "title",
          "type": "text",
          "content": "{title}",
          "font": "Inter Tight",
          "weight": 400,
          "size": 86,
          "letterSpacing": -0.025,
          "x": 48,
          "y": 952,
          "maxWidth": 904,
          "maxLines": 1,
          "fit": "shrink",
          "color": "{ink}",
          "effects": [
            {
              "kind": "shadow",
              "x": 0,
              "y": 2,
              "blur": 10,
              "color": "#000000",
              "opacity": 0.35
            }
          ]
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.06
    }
  ]
}
