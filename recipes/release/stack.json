{
  "$schema": "../../schema/recipe.schema.json",
  "name": "stack",
  "description": "Brutalist type: the artist three times, condensed, stretched tall and stacked edge to edge (the middle one in outline), and the title in a solid bar across the foot. Slots: {name} (artist), {title} (release), the palette (bg, text, accent). Fonts: Big Shoulders Display, Space Mono Bold (register them as TTF/WOFF; WOFF2 can't be outlined).",
  "vars": {
    "est": {
      "div": [
        940,
        {
          "mul": [
            {
              "length": "{name}"
            },
            0.43
          ]
        }
      ]
    },
    "sy": {
      "min": [
        5,
        {
          "max": [
            1,
            {
              "div": [
                226,
                {
                  "mul": [
                    "$est",
                    0.8
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "id": "page",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "one",
          "type": "text",
          "content": {
            "upper": "{name}"
          },
          "font": "Big Shoulders Display",
          "weight": 900,
          "size": "$est",
          "letterSpacing": 0.035,
          "x": 30,
          "y": 262,
          "width": 940,
          "fit": "width",
          "stretch": [
            1,
            "$sy"
          ],
          "color": "@text"
        },
        {
          "id": "two",
          "type": "text",
          "content": {
            "upper": "{name}"
          },
          "font": "Big Shoulders Display",
          "weight": 900,
          "size": "$est",
          "letterSpacing": 0.035,
          "x": 30,
          "y": 512,
          "width": 940,
          "fit": "width",
          "stretch": [
            1,
            "$sy"
          ],
          "fill": "none",
          "stroke": "@text",
          "strokeWidth": 3
        },
        {
          "id": "three",
          "type": "text",
          "content": {
            "upper": "{name}"
          },
          "font": "Big Shoulders Display",
          "weight": 900,
          "size": "$est",
          "letterSpacing": 0.035,
          "x": 30,
          "y": 762,
          "width": 940,
          "fit": "width",
          "stretch": [
            1,
            "$sy"
          ],
          "color": "@accent"
        },
        {
          "id": "bar",
          "type": "shape",
          "kind": "rect",
          "x": 0,
          "y": 800,
          "width": 1000,
          "height": 200,
          "fill": "@text"
        },
        {
          "id": "title",
          "type": "text",
          "content": {
            "upper": "{title}"
          },
          "font": "Space Mono",
          "weight": 700,
          "size": 92,
          "letterSpacing": -0.04,
          "x": 30,
          "y": 932,
          "maxWidth": 940,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@bg"
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.06,
      "blend": "multiply"
    }
  ]
}
