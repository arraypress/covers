{
  "$schema": "../../schema/recipe.schema.json",
  "name": "swiss",
  "description": "Swiss grid: the square cut into thirds by hairlines, the artist (bold) and title (regular) ragged-right in the top row, and the mark set big in the accent across the lower two-thirds, flush to the grid. Slots: {name} (artist), {title} (release), {mark}, the palette (bg, text, accent). Fonts: Archivo (variable, wdth 62–125) (register them as TTF/WOFF; WOFF2 can't be outlined).",
  "requires": [
    "mark"
  ],
  "layers": [
    {
      "id": "page",
      "type": "solid",
      "color": "@bg"
    },
    {
      "id": "cover",
      "type": "group",
      "viewBox": [
        0,
        0,
        1000,
        1000
      ],
      "fit": "cover",
      "layers": [
        {
          "id": "rules",
          "type": "shape",
          "stroke": "@text",
          "strokeWidth": 2,
          "items": [
            {
              "kind": "line",
              "x1": 0,
              "y1": 333,
              "x2": 1000,
              "y2": 333
            },
            {
              "kind": "line",
              "x1": 333,
              "y1": 128,
              "x2": 333,
              "y2": 1000
            },
            {
              "kind": "line",
              "x1": 666,
              "y1": 333,
              "x2": 666,
              "y2": 1000,
              "opacity": 0.3
            },
            {
              "kind": "line",
              "x1": 333,
              "y1": 666,
              "x2": 1000,
              "y2": 666,
              "opacity": 0.3
            }
          ]
        },
        {
          "id": "mark",
          "type": "icon",
          "markup": "{mark}",
          "x": 311.3125,
          "y": 311.3125,
          "size": 716.5714285714287,
          "color": "@accent"
        },
        {
          "id": "name",
          "type": "text",
          "content": "{name}",
          "font": "Archivo",
          "weight": 800,
          "axes": {
            "wdth": 80
          },
          "size": 92,
          "letterSpacing": -0.02,
          "x": 24,
          "y": 88,
          "maxWidth": 952,
          "maxLines": 1,
          "fit": "shrink",
          "color": "@text"
        },
        {
          "id": "title",
          "type": "text",
          "content": "{title}",
          "font": "Archivo",
          "weight": 400,
          "axes": {
            "wdth": 80
          },
          "size": 92,
          "lineHeight": 0.98,
          "letterSpacing": -0.02,
          "x": 357,
          "y": 192,
          "maxWidth": 620,
          "maxLines": 2,
          "balance": false,
          "color": "@text"
        }
      ]
    },
    {
      "id": "grain",
      "type": "grain",
      "amount": 0.03
    }
  ]
}
